  "abilities": [
    {
      "code": "ab701_team_rr",
      "name": {
        "en": "Group:RecordOfRagnarok",
        "th": "[กลุ่ม] มหาศึกคนชนเทพ"
      },
      "desc": {
        "en": "Record of Ragnarok Tie-Up! Put Rangers of a group into a Team and ATK buffs will be applied in battle.\nYou must have a Team of at least 2 Rangers for group buffs to apply. The more Rangers you have in a Team from the same group, the stronger the buffs will be. (There are 5 buff levels.)",
        "th": "จะได้รับผลลัพธ์บัฟ 'พลังโจมตี' ในการต่อสู้เมื่อติดตั้งเรนเจอร์ 'โคลาโบ มหาศึกคนชนเทพ' ลงในทีม\n\nจะได้รับเมื่อติดตั้งอย่างน้อย2ตัว และสามารถอัพเกรดผลลัพธ์บัฟได้สูงสุด5ขั้นหากติดตั้งเรนเจอร์หลายตัวจากกลุ่มเดียวกัน"
      },
      "icon": "icons/ab701_team_rr_icon.png",
      "groupBuff": true
    },
    {
      "code": "ab211_passres_agi",
      "name": {
        "en": "Nullify Skill Resistance\\n: Agility",
        "th": "ต้านการต้านทักษะ: ความว่องไว"
      },
      "desc": {
        "en": "Fixed chance of ignoring an Agility type enemy's Skill Resistance when attacking.",
        "th": "มีโอกาสทำให้การต้านทักษะของศัตรูชนิดความว่องไวไม่มีผลเมื่อโจมตี"
      },
      "icon": "icons/ab211_passres_icon.png",
      "groupBuff": true
    }
