      }
    },
    "skill2": null,
    "skill3": {
      "slot": "skill3",
      "code": "hsk1090_boss",
      "name": {
        "en": "Go, go, Evil Croc!",
        "th": "ลุยเลย เกมจระเข้ชั่วร้าย!",
        "zh": "鱷魚牙醫兇猛突擊",
        "jp": "突撃！凶悪のワニゲーム！"
      },
      "desc": {
        "en": "Charges at enemies with a crocodile at super high speed.\\n\\n*ATK x 4000% Area Damage \\n*Enemy knockback \\n*Continuously cancels enemy invincibility (3 sec)",
        "th": "จระเข้ความเร็วสูงจะพุ่งเข้าชนศัตรู\\n\\n*สร้างความเสียหาย 4000% ของพลังโจมตีลงในพื้นที่ \\n*โจมตีทำให้ศัตรูกระเด็นถอยหลัง \\n*ยกเลิกภาวะอมตะของศัตรู อย่างต่อเนื่อง (3 วินาที)",
        "zh": "讓全速衝刺的鱷魚衝向敵方陣容。\\n\\n*攻擊力×4000%的範圍傷害 \\n*產生擊退效果 \\n*解除敵人的持續無敵狀態 (3秒)",
        "jp": "最大速力のワニが敵陣へ突進します。\\n\\n*攻撃力×4000%の範囲ダメージ \\n*敵軍ノックバック効果 \\n*敵の無敵持続解除 (3秒)"
      },
      "icon": "icons/skill_icon_usk1090_boss.png",
