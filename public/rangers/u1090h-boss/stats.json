  "abilities": [
    {
      "code": "ab105_frozenheart",
      "name": {
        "en": "Stone Cold",
        "th": "หัวใจยะเยือก",
        "zh": "堅忍的心臟",
        "jp": "凍りついた心臓"
      },
      "desc": {
        "en": "Rangers with this Ability won't be turned against their allies \\nin stages with the Siren Song obstacle effect.",
        "th": "เรนเจอร์ที่มีความสามารถนี้จะไม่ได้รับผลกระทบใดๆ ถึงแม้ผลลัพธ์ของ \\n\"ลำนำเย้ายวน\" จะแสดงผลในสเตจจุติก็ตาม",
        "zh": "當降臨關卡發動「誘惑之歌」妨礙效果時，\\n持有這個能力的Ranger不會受到影響。",
        "jp": "降臨ステージで「誘惑の歌」妨害効果発動の際、\\nこのアビリティを保有しているレンジャーは誘惑の歌の影響を受けません。"
      },
      "icon": "icons/ab105_frozenheart_icon.png",
      "groupBuff": false
    },
    {
      "code": "ab206_mindisturb",
      "name": {
        "en": "Mineral Mooch",
        "th": "ขัดขวางการผลิตแร่ธาตุ",
        "zh": "妨礙礦物生產",
        "jp": "ミネラル生産妨害"
      },
      "desc": {
        "en": "Steal the opposing team's minerals, slowing their production.\\n(Production is slowed by per Ranger with this Ability that joins the battle)",
        "th": "ช่วงชิงแร่ธาตุของทีมตรงข้ามและลดความเร็วในการผลิตลง\\n(อัตราการผลิตช้าลงตามจำนวนเรนเจอร์ผู้มีความสามารถนี้ ที่เข้าร่วมการต่อสู้)",
        "zh": "奪取對方隊伍的礦物，降低礦物生產速度。\\n(有此能力的Ranger參與戰鬥時，將降低對方的礦物生產速度)",
        "jp": "相手チームのミネラルを奪い取って生産速度を落とします。\\n(アビリティを所持したレンジャーが戦闘に参加すると減少)"
      },
      "icon": "icons/ab206_mindisturb_icon.png",
      "groupBuff": false
