  "abilities": [
    {
      "code": "ab701_team_2506",
      "name": {
        "en": "Group: Yozakura",
        "th": "[กลุ่ม] โยซากุระ"
      },
      "desc": {
        "en": "Yozakura Tie-Up! Put Rangers of a group into a Team and ATK buffs will be applied in battle.\nYou must have a Team of at least 2 Rangers for group buffs to apply. The more Rangers you have in a Team from the same group, the stronger the buffs will be. (There are 5 buff levels.)",
        "th": "จะได้รับผลลัพธ์บัฟ 'พลังโจมตี' ในการต่อสู้เมื่อติดตั้งเรนเจอร์ 'โคลาโบ โยซากุระ' ลงในทีม\n\nจะได้รับเมื่อติดตั้งอย่างน้อย 2 ตัว และสามารถอัพเกรดผลลัพธ์บัฟได้สูงสุด 5 ขั้นหากติดตั้งเรนเจอร์หลายตัวจากกลุ่มเดียวกัน"
      },
      "icon": "icons/ab701_team_2506_icon.png",
      "groupBuff": true
    },
    {
      "code": "ab604_copyally",
      "name": {
        "en": "Ally Clone",
        "th": "โคลนนิ่งพรรคพวก"
      },
      "desc": {
        "en": "Has a set chance of summoning 1 allied team Ranger when Rangers deploy.　 \n- Flyer and Air Ambush Rangers are not eligible to be summoned in this way. \n- The Abilities of allied Rangers summoned by this Ability won't activate.\n- Summoned Rangers won't consume any Mineral and will have no effects on redeploy times.",
        "th": "เมื่อออกปฏิบัติการมีโอกาสเรียกเรนเจอร์ในทีมเดียวกันออกมา 1 ตัว\n\n*เรนเจอร์บินและเรนเจอร์สกัดกั้นยูนิตบินจะไม่เข้าข่าย\n*ความสามารถของเรนเจอร์พรรคพวกที่เรียกด้วยความสามารถนี้จะไม่แสดงผล\n*เรนเจอร์พรรคพวกที่ถูกเรียกจะไม่ใช้แร่ธาตุ และไม่มีผลกระทบต่อเวลารอสร้าง"
      },
      "icon": "icons/ab604_copyally_icon.png",
      "groupBuff": true
    }
