  "abilities": [
    {
      "code": "ab233_antifreeze",
      "name": {
        "en": "Resistance: Deployment Freeze",
        "th": "ต่อต้าน:หยุดศัตรูออกปฏิบัติการชั่วคราว"
      },
      "desc": {
        "en": "Rangers with this Ability block enemies' Deployment Freeze Ability.",
        "th": "เรนเจอร์ที่มีความสามารถนี้จะป้องกันความสามารถ \"หยุดศัตรูออกปฏิบัติการชั่วคราว\" ของศัตรูได้"
      },
      "icon": "icons/ab233_antifreeze_icon.png",
      "groupBuff": false
    },
    {
      "code": "ab227_st_kback2agi",
      "name": {
        "en": "Deploy Knockback+ : Agility",
        "th": "กระเด็นถอยหลังเมื่อออกปฏิบัติการ+ \n: ความว่องไว"
      },
      "desc": {
        "en": "Has a super high chance of knocking back all Agility type enemies and canceling their Skill Barrier effects when Rangers deploy.\n\n- Activates 5 seconds after battles start.\n- You must wait 3 seconds before you can use an Ability again after using one with the same effect on the same type of Ranger.\n- Guardians, Bosses, and special type enemies are not affected by this Ability.",
        "th": "เมื่อออกปฏิบัติการมีโอกาสสูงมากที่จะทำให้ศัตรูชนิด \"ความว่องไว\" ทั้งหมดกระเด็นไปด้านหลังและยกเลิกบาเรียทักษะ\n\n*จะแสดงผลหลังเริ่มการต่อสู้ไปแล้ว 5 วินาที\n*หากความสามารถที่มีผลลัพธ์เหมือนกันมีเป้าหมายเป็นเรนเจอร์ชนิดเดียวกัน จะไม่แสดงผลต่อเนื่องโดยห่างกันเป็นเวลา 3 วินาที\n*ใช้ความสามารถนี้กับผู้พิทักษ์ บอส และศัตรูชนิดพิเศษไม่ได้"
      },
      "icon": "icons/ab227_st_kback_icon.png",
      "groupBuff": false
    }
