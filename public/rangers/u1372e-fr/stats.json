  "abilities": [
    {
      "code": "ab701_team_2402",
      "name": {
        "en": "Group: Frieren",
        "th": "[กลุ่ม] Frieren"
      },
      "desc": {
        "en": "Frieren Tie-Up! Put Rangers of a group into a Team and ATK buffs will be applied in battle.\nYou must have a Team of at least 2 Rangers for group buffs to apply. The more Rangers you have in a Team from the same group, the stronger the buffs will be. (There are 5 buff levels.)",
        "th": "จะได้รับผลลัพธ์บัฟ 'พลังโจมตี' ในการต่อสู้เมื่อติดตั้งเรนเจอร์ 'โคลาโบ Frieren' ลงในทีม\n\nจะได้รับเมื่อติดตั้งอย่างน้อย 2 ตัว และสามารถอัพเกรดผลลัพธ์บัฟได้สูงสุด 5 ขั้นหากติดตั้งเรนเจอร์หลายตัวจากกลุ่มเดียวกัน"
      },
      "icon": "icons/ab701_team_2402_icon.png",
      "groupBuff": true
    },
    {
      "code": "ab230_barrier",
      "name": {
        "en": "Skill Barrier",
        "th": "บาเรียทักษะ"
      },
      "desc": {
        "en": "Continuously provides a barrier that protects against Skill Damage.\n- The Skill Barrier disappears after blocking Skill Damage 1 time and is reapplied 3 seconds later.\n- The Skill Barrier remains intact when Skill Damage is reduced to 0 through invincibility.\n- Boss, Guardian, and Special Type enemies' Skill Damage cannot be blocked.",
        "th": "สร้างบาเรียป้องกันความเสียหายทักษะให้แก่ตนเองแบบต่อเนื่อง\n*บาเรียทักษะจะหายไปเมื่อป้องกันความเสียหายทักษะ 1 ครั้ง และจะสร้างใหม่ในอีก 3 วินาทีต่อมา\n*หากความเสียหายทักษะเป็น 0 เนื่องจากภาวะอมตะ บาเรียทักษะจะไม่หายไป\n*ไม่สามารถป้องกันความเสียหายทักษะจากบอส ผู้พิทักษ์ และศัตรูชนิดพิเศษได้"
      },
      "icon": "icons/ab230_barrier_icon.png",
      "groupBuff": true
    }
