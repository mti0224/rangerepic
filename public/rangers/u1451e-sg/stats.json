  "abilities": [
    {
      "code": "ab701_team_2412",
      "name": {
        "en": "Group: GINTAMA",
        "th": "[กลุ่ม] กินทามะ"
      },
      "desc": {
        "en": "GINTAMA Tie-Up! Put Rangers of a group into a Team and HP buffs will be applied in battle.\nYou must have a Team of at least 2 Rangers for group buffs to apply. The more Rangers you have in a Team from the same group, the stronger the buffs will be. (There are 5 buff levels.)",
        "th": "จะได้รับผลลัพธ์บัฟ 'พลังชีวิต' ในการต่อสู้เมื่อติดตั้งเรนเจอร์ 'โคลาโบ กินทามะ' ลงในทีม\n\nจะได้รับเมื่อติดตั้งอย่างน้อย 2 ตัว และสามารถอัพเกรดผลลัพธ์บัฟได้สูงสุด 5 ขั้นหากติดตั้งเรนเจอร์หลายตัวจากกลุ่มเดียวกัน"
      },
      "icon": "icons/ab701_team_2412_icon.png",
      "groupBuff": true
    },
    {
      "code": "ab219_mineraladd2",
      "name": {
        "en": "Enemy Cost Increase2",
        "th": "ศัตรูใช้แร่ธาตุเพิ่มขึ้น2"
      },
      "desc": {
        "en": "Gives a set chance of greatly increasing the Mineral Cost for one of the opposing team's Rangers when Rangers with this Ability are deployed. \\nThis Ability can activate from 10 seconds after the battle starts.",
        "th": "มีโอกาสในระดับหนึ่งที่จะเพิ่มค่าแร่ธาตุเรนเจอร์ซึ่งจะออกปฏิบัติการของทีมศัตรู 1 ตัวอย่างมากเมื่อเรนเจอร์ที่มีความสามารถนี้ออกปฏิบัติการ \\nความสามารถนี้จะแสดงผลเมื่อผ่านไป 10 วินาทีหลังเริ่มการต่อสู้"
      },
      "icon": "icons/ab219_mineraladd_icon.png",
      "groupBuff": true
    }
