    "skill2": null,
    "skill3": {
      "slot": "skill3",
      "code": "hsk1542_za",
      "name": {
        "en": "Sasumata Stroke",
        "th": "แทงไม้ง่าม"
      },
      "desc": {
        "en": "Takes a stance and runs towards enemies.\nSwings up Lovely Assistaff and attacks them.\\n\\n*Enemy Move Speed -30% (6 sec)\\n*Enemy Skill Evade Rate -60% (6 sec)\\n*ATK x 4000% Area Damage ",
        "th": "ตั้งท่าแล้ววิ่งเข้าหาศัตรู\nก่อนแทงไม้คทาคู่ใจขึ้นเพื่อโจมตี\\n\\n*ลดความเร็วการเคลื่อนที่ของศัตรู 30% (6 วินาที)\\n*ลดอัตราการหลบทักษะของศัตรู 60% (6 วินาที)\\n*สร้างความเสียหาย 4000% ของพลังโจมตีลงในพื้นที่ "
      },
