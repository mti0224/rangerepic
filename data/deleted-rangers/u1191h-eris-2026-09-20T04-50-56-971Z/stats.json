  "abilities": [
    {
      "code": "ab701_team_mt",
      "name": {
        "en": "Group: Mushoku Tensei",
        "th": "[กลุ่ม] เกิดชาตินี้พี่ต้องเทพ"
      },
      "desc": {
        "en": "Mushoku Tensei Tie-Up! Put Rangers of a group into a Team and HP buffs will be applied in battle.\nYou must have a Team of at least 2 Rangers for group buffs to apply. The more Rangers you have in a Team from the same group, the stronger the buffs will be. (There are 5 buff levels.)",
        "th": "จะได้รับผลลัพธ์บัฟ'พลังชีวิต'ในการต่อสู้เมื่อติดตั้งเรนเจอร์'โคลาโบเกิดชาตินี้พี่ต้องเทพ'ลงในทีม\n\nจะได้รับเมื่อติดตั้งอย่างน้อย2ตัวและสามารถอัพเกรดผลลัพธ์บัฟได้สูงสุด5ขั้นหากติดตั้งเรนเจอร์หลายตัวจากกลุ่มเดียวกัน"
      },
      "icon": "icons/ab701_team_mt_icon.png",
      "groupBuff": true
    },
    {
      "code": "ab224_cooltimeadd",
      "name": {
        "en": "Deployment Freeze",
        "th": "หยุดศัตรูออกปฏิบัติการชั่วคราว"
      },
      "desc": {
        "en": "Gives a high chance that 1 Ranger on the opposite team will have the time until it can be redeployed frozen for a fixed amount of time when a Ranger with this Ability is deployed. Activates 10 seconds after the battle starts.",
        "th": "เมื่อเรนเจอร์ที่มีความสามารถนี้ออกปฏิบัติการจะมีโอกาสสูงที่จะหยุดเกจเวลารอสร้างของเรนเจอร์ทีมตรงข้าม1ตัวในช่วงระยะเวลาหนึ่งความสามารถนี้จะแสดงผลเมื่อผ่านไป10วินาทีหลังเริ่มการต่อสู้"
      },
      "icon": "icons/ab224_cooltimeadd_icon.png",
      "groupBuff": true
    }
