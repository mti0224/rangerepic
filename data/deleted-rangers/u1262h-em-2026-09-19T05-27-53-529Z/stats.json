  "abilities": [
    {
      "code": "ab701_team_rz",
      "name": {
        "en": "Group: Re:ZERO",
        "th": "[กลุ่ม] Re: ZERO"
      },
      "desc": {
        "en": "Re:ZERO Tie-Up! Put Rangers of a group into a Team and ATK buffs will be applied in battle.\nYou must have a Team of at least 2 Rangers for group buffs to apply. The more Rangers you have in a Team from the same group, the stronger the buffs will be. (There are 5 buff levels.)",
        "th": "จะได้รับผลลัพธ์บัฟ 'พลังโจมตี' ในการต่อสู้เมื่อติดตั้งเรนเจอร์ 'โคลาโบ Re: ZERO' ลงในทีม\n\nจะได้รับเมื่อติดตั้งอย่างน้อย 2 ตัว และสามารถอัพเกรดผลลัพธ์บัฟได้สูงสุด 5 ขั้นหากติดตั้งเรนเจอร์หลายตัวจากกลุ่มเดียวกัน"
      },
      "icon": "icons/ab701_team_rz_icon.png",
      "groupBuff": true
    },
    {
      "code": "ab227_st_stun_agi",
      "name": {
        "en": "Deploy Stun: Agility",
        "th": "ชะงักเมื่อออกปฏิบัติการ: ความว่องไว"
      },
      "desc": {
        "en": "Has a high chance of stunning all Agility type enemies and canceling their invincibility skill effects when Rangers deploy.\n- Activates 5 seconds after battles start.\n- You must wait 6 seconds before you can use an Ability again after using one with the same effect on the same type of Ranger.\n- Bosses, Guardians, and special type enemies are not affected by this Ability.",
        "th": "เมื่อออกปฏิบัติการมีโอกาสสูงที่จะทำให้ศัตรูชนิด \"ความว่องไว\" ทั้งหมดชะงักและยกเลิกทักษะอมตะ\n*จะแสดงผลหลังเริ่มการต่อสู้ไปแล้ว 5 วินาที\n*หากความสามารถที่มีผลลัพธ์เหมือนกันมีเป้าหมายเป็นเรนเจอร์ชนิดเดียวกัน จะไม่แสดงผลต่อเนื่องโดยห่างกันเป็นเวลา 6 วินาที\n*ใช้ความสามารถนี้กับผู้พิทักษ์, บอส และศัตรูชนิดพิเศษไม่ได้"
      },
      "icon": "icons/ab227_st_stun_icon.png",
      "groupBuff": true
    }
  ],
