  "abilities": [
    {
      "code": "ab701_team_2608",
      "name": {
        "en": "Group: Kaiju No. 8",
        "th": "[กลุ่ม] ไคจูหมายเลข 8"
      },
      "desc": {
        "en": "Kaiju No. 8 Tie-Up! Put Rangers of a group into a Team and HP buffs will be applied in battle.\n You must have a Team of at least 2 Rangers for group buffs to apply. The more Rangers you have in a Team from the same group, the stronger the buffs will be. (There are 5 buff levels.)",
        "th": "จะได้รับผลลัพธ์บัฟ 'พลังชีวิต' ในการต่อสู้เมื่อติดตั้งเรนเจอร์ 'โคลาโบ ไคจูหมายเลข 8' ลงในทีม\n \n จะได้รับเมื่อติดตั้งอย่างน้อย 2 ตัว และสามารถอัพเกรดผลลัพธ์บัฟได้สูงสุด 5 ขั้นหากติดตั้งเรนเจอร์หลายตัวจากกลุ่มเดียวกัน"
      },
      "icon": "icons/ab701_team_2608_icon.png",
      "groupBuff": true
    },
    {
      "code": "ab223_guts2",
      "name": {
        "en": "Persistence+",
        "th": "เฮือกสุดท้าย+"
      },
      "desc": {
        "en": "Rangers with this Ability activate Persistence when defeated. When Persistence activates, Rangers hold on for 7 more seconds with a dramatic ATK increase.",
        "th": "มีโอกาสที่ \"เฮือกสุดท้าย\" จะทำงานเมื่อเรนเจอร์ที่มีความสามารถนี้จะถูกกำจัด หาก \"เฮือกสุดท้าย\" ทำงานเรนเจอร์จะไม่ถูกกำจัดเป็นเวลา 7 วินาทีและพลังโจมตีจะเพิ่มขึ้นอย่างก้าวกระโดด"
      },
