NODE_ENV=production
HOST=127.0.0.1
PORT=4174

# 使用 npm run hash:admin-password 產生，不要提交真正的密碼或雜湊到 Git。
ADMIN_PASSWORD_HASH=scrypt$REPLACE_SALT$REPLACE_HASH
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
SESSION_TTL_SEC=43200
COOKIE_SECURE=true
TRUST_PROXY=true

# 啟用後，每次新增／修改／刪除 Ranger 都會 git commit + push。
AUTO_GIT_PUSH=true
GIT_REMOTE=origin
GIT_BRANCH=main
GIT_AUTHOR_NAME=RangerEpic Admin
GIT_AUTHOR_EMAIL=rangerepic-admin@localhost
